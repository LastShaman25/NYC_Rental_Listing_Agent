# Copy to .env and adjust. Never commit .env. No real credentials belong in this file.

# Profile: development | production
RENTAL_PROFILE=development
RENTAL_OPERATOR_ID=local_operator

# Local PostgreSQL/PostGIS (docker-compose.yml serves port 5433)
RENTAL_DB_HOST=localhost
RENTAL_DB_PORT=5433
RENTAL_DB_USER=rental
RENTAL_DB_PASSWORD=rental_local_dev
RENTAL_DB_DATABASE=rental_dev

# Local data roots (relative to project root by default)
RENTAL_DATA_ROOT=local_data

# Providers (owner decisions B3/B5/B7, 2026-08-17; keys stay empty until integration)
# No paid Google APIs; the free Maps Embed view is used on listing detail only.
RENTAL_PROVIDER_GOOGLE_MAPS_EMBED_ENABLED=true
RENTAL_PROVIDER_LLM_PROVIDER_CODE=openai
RENTAL_PROVIDER_LLM_DEFAULT_MODEL_ID=gpt-5.6-terra
RENTAL_PROVIDER_LLM_DEFAULT_REASONING_EFFORT=low
RENTAL_PROVIDER_LLM_FLAGSHIP_MODEL_ID=gpt-5.6-sol
RENTAL_PROVIDER_LLM_FLAGSHIP_REASONING_EFFORT=medium
RENTAL_PROVIDER_OPENAI_API_KEY=
# Optional: point at any OpenAI-compatible endpoint (empty = OpenAI itself).
# Editable from the web UI: Settings → LLM API.
RENTAL_PROVIDER_LLM_BASE_URL=
# Tavily search API (tavily.com): create a free account (~1,000 credits/month)
# and put your tvly-... key below.
RENTAL_PROVIDER_SEARCH_PROVIDER_CODE=tavily
RENTAL_PROVIDER_SEARCH_PROVIDER_API_KEY=
RENTAL_PROVIDER_COMMUTE_RESEARCH_CACHE_DAYS=14
RENTAL_PROVIDER_MAP_TILE_PROVIDER_CODE=osm_default
